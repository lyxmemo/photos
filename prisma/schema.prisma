generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  photos    Photo[]
}

model Photo {
  id          String   @id @default(cuid())
  title       String
  description String?
  filename    String
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tags        Tag[]
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  photos Photo[]
}
